# Copy this file to .env and change the values.
# .env is gitignored - never commit real keys.

NODE_ENV=development
PORT=3000

# SQLite file path (relative to the project root). Use :memory: for tests.
DB_PATH=data/retailpulse.db

# Comma-separated API keys. Admin keys can read + write + run jobs.
# Read keys can only call GET endpoints and execute intents.
ADMIN_API_KEYS=dev-admin-key-change-me
READ_API_KEYS=dev-read-key-change-me

# Comma-separated list of browser origins allowed by CORS
CORS_ORIGINS=http://localhost:3000

# Rate limit: max requests per API key per window
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# LRU cache size (number of entries)
CACHE_MAX_ENTRIES=500

# Workflow orchestrator
JOB_CONCURRENCY=2
JOB_MAX_RETRIES=3
JOB_BACKOFF_BASE_MS=1000
SHUTDOWN_TIMEOUT_MS=10000
# Enqueue a DAILY_REPORT job every 24h (true/false)
ENABLE_SCHEDULER=true

# CSV ingestion
BATCH_SIZE=1000
# Folder that CSV import jobs are allowed to read from (prevents path traversal)
IMPORT_DIR=data

# Number of sales rows the seed script generates
SEED_SALES_ROWS=200000

# Log level: error | warn | info | debug | silent
LOG_LEVEL=info
